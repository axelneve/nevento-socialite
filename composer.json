{
    "name": "eventsolutions/nevento-socialite",
    "description": "Nevento IDP OAuth2 Socialite driver + tenant-provisioning contract for EventSolutions client website backends",
    "version": "1.4.0",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "laravel/socialite": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "EventSolutions\\NeventoSocialite\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EventSolutions\\NeventoSocialite\\NeventoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload-dev": {
        "psr-4": {
            "EventSolutions\\NeventoSocialite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
